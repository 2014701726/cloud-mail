# cloud-mail 自建部署配置（复制为 .env 后修改）
PORT=8787
HOST=127.0.0.1
DATA_DIR=data

# 必填：JWT 签名密钥，随便一串 32 位以上随机字符
JWT_SECRET=change-me-please-use-a-long-random-string

# 必填：管理员邮箱，必须是 MAIL_DOMAINS 里的域名
ADMIN_EMAIL=admin@example.com

# 必填：收信域名，多个用英文逗号分隔，不要带 @
MAIL_DOMAINS=example.com

# 必填：MTA（Postfix）投递原始邮件时使用的共享密钥
INGEST_SECRET=change-me-too

# 可选：未注册地址的邮件是否归入管理员主邮箱
CATCH_ALL_ADMIN=true
# 可选：/codes 免登录验证码页面
PUBLIC_CODES=true
# 可选：code_all_recipient 参数值，留空关闭“查看全部收件人”
CODE_ALL_RECIPIENT=all
# 可选：只允许这些发件人的验证码出现在 /codes，留空不限制
CODE_ALLOWED_SENDERS=
# 可选：AI 验证码识别模型（自建默认关闭，正则识别仍然有效）
AI_MODEL=
